#include <stdlib.h>
#include <string.h>

typedef struct {
    int* data;
    int size;
    int capacity;
} Heap;

typedef struct {
    int key;
    int count;
} HashEntry;

typedef struct {
    HashEntry* entries;
    int capacity;
    int size;
} HashMap;

static int hash(int key, int cap) {
    unsigned int h = (unsigned int)key;
    return h % cap;
}

static void hash_insert(HashMap* map, int key) {
    int idx = hash(key, map->capacity);
    while (map->entries[idx].count != 0 && map->entries[idx].key != key) {
        idx = (idx + 1) % map->capacity;
    }
    map->entries[idx].key = key;
    map->entries[idx].count++;
}

static int hash_get_and_decrement(HashMap* map, int key) {
    int idx = hash(key, map->capacity);
    while (map->entries[idx].count != 0) {
        if (map->entries[idx].key == key) {
            if (map->entries[idx].count > 0) {
                map->entries[idx].count--;
                return 1;
            }
            return 0;
        }
        idx = (idx + 1) % map->capacity;
    }
    return 0;
}

static void push_max_heap(Heap* h, int val) {
    h->data[h->size] = val;
    int i = h->size++;
    while (i > 0) {
        int p = (i - 1) / 2;
        if (h->data[p] >= h->data[i]) break;
        int tmp = h->data[p]; h->data[p] = h->data[i]; h->data[i] = tmp;
        i = p;
    }
}

static void push_min_heap(Heap* h, int val) {
    h->data[h->size] = val;
    int i = h->size++;
    while (i > 0) {
        int p = (i - 1) / 2;
        if (h->data[p] <= h->data[i]) break;
        int tmp = h->data[p]; h->data[p] = h->data[i]; h->data[i] = tmp;
        i = p;
    }
}

static void max_heapify(Heap* h, int i) {
    int largest = i;
    int l = 2 * i + 1;
    int r = 2 * i + 2;
    if (l < h->size && h->data[l] > h->data[largest]) largest = l;
    if (r < h->size && h->data[r] > h->data[largest]) largest = r;
    if (largest != i) {
        int tmp = h->data[i]; h->data[i] = h->data[largest]; h->data[largest] = tmp;
        max_heapify(h, largest);
    }
}

static void min_heapify(Heap* h, int i) {
    int smallest = i;
    int l = 2 * i + 1;
    int r = 2 * i + 2;
    if (l < h->size && h->data[l] < h->data[smallest]) smallest = l;
    if (r < h->size && h->data[r] < h->data[smallest]) smallest = r;
    if (smallest != i) {
        int tmp = h->data[i]; h->data[i] = h->data[smallest]; h->data[smallest] = tmp;
        min_heapify(h, smallest);
    }
}

static int pop_max_heap(Heap* h) {
    int res = h->data[0];
    h->data[0] = h->data[--h->size];
    max_heapify(h, 0);
    return res;
}

static int pop_min_heap(Heap* h) {
    int res = h->data[0];
    h->data[0] = h->data[--h->size];
    min_heapify(h, 0);
    return res;
}

static void prune_max_heap(Heap* h, HashMap* map) {
    while (h->size > 0 && map->entries[hash(h->data[0], map->capacity)].count > 0) {
        int idx = hash(h->data[0], map->capacity);
        while (map->entries[idx].key != h->data[0]) {
            idx = (idx + 1) % map->capacity;
        }
        if (map->entries[idx].count > 0) {
            map->entries[idx].count--;
            pop_max_heap(h);
        } else {
            break;
        }
    }
}

static void prune_min_heap(Heap* h, HashMap* map) {
    while (h->size > 0 && map->entries[hash(h->data[0], map->capacity)].count > 0) {
        int idx = hash(h->data[0], map->capacity);
        while (map->entries[idx].key != h->data[0]) {
            idx = (idx + 1) % map->capacity;
        }
        if (map->entries[idx].count > 0) {
            map->entries[idx].count--;
            pop_min_heap(h);
        } else {
            break;
        }
    }
}

double* medianSlidingWindow(int* nums, int numsSize, int k, int* returnSize) {
    if (numsSize == 0 || k == 0) {
        *returnSize = 0;
        return NULL;
    }

    int totalWindows = numsSize - k + 1;
    double* result = (double*)malloc(totalWindows * sizeof(double));
    *returnSize = totalWindows;

    Heap small = { (int*)malloc(numsSize * sizeof(int)), 0, numsSize };
    Heap large = { (int*)malloc(numsSize * sizeof(int)), 0, numsSize };

    HashMap delayed;
    delayed.capacity = numsSize * 2 + 1;
    delayed.entries = (HashEntry*)calloc(delayed.capacity, sizeof(HashEntry));

    int small_size = 0, large_size = 0;

    for (int i = 0; i < k; i++) {
        push_max_heap(&small, nums[i]);
        small_size++;
    }
    for (int i = 0; i < k / 2; i++) {
        push_min_heap(&large, pop_max_heap(&small));
        small_size--;
        large_size++;
    }

    if (k % 2 == 1) {
        result[0] = (double)small.data[0];
    } else {
        result[0] = ((double)small.data[0] + (double)large.data[0]) / 2.0;
    }

    for (int i = k; i < numsSize; i++) {
        int out_num = nums[i - k];
        int in_num = nums[i];
        int balance = 0;

        balance += (out_num <= small.data[0]) ? -1 : 1;
        hash_insert(&delayed, out_num);

        if (small.size > 0 && in_num <= small.data[0]) {
            push_max_heap(&small, in_num);
            balance++;
        } else {
            push_min_heap(&large, in_num);
            balance--;
        }

        if (balance < 0) {
            push_max_heap(&small, pop_min_heap(&large));
            balance++;
        } else if (balance > 0) {
            push_min_heap(&large, pop_max_heap(&small));
            balance--;
        }

        prune_max_heap(&small, &delayed);
        prune_min_heap(&large, &delayed);

        if (k % 2 == 1) {
            result[i - k + 1] = (double)small.data[0];
        } else {
            result[i - k + 1] = ((double)small.data[0] + (double)large.data[0]) / 2.0;
        }
    }

    free(small.data);
    free(large.data);
    free(delayed.entries);

    return result;
}
