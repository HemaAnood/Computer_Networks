#include <stdbool.h>

bool hasAlternatingBits(int n) {
    int last_bit = n % 2;
    n /= 2;
    while (n > 0) {
        int current_bit = n % 2;
        if (current_bit == last_bit) {
            return false;
        }
        last_bit = current_bit;
        n /= 2;
    }
    return true;
}

