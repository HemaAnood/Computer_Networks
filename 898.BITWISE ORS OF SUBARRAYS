#include <stdio.h>
#include <stdlib.h>
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}
int subarrayBitwiseORs(int* arr, int arrSize) {
    if (arrSize == 0) return 0;
    int* res = (int*)malloc(arrSize * 32 * sizeof(int));
    int resSize = 0;
    int curr[32];
    int currSize = 0;
    for (int i = 0; i < arrSize; i++) {
        int num = arr[i];
        int nextCurr[32];
        int nextCurrSize = 0;
        nextCurr[nextCurrSize++] = num;
        for (int j = 0; j < currSize; j++) {
            int orVal = curr[j] | num;
            if (orVal != nextCurr[nextCurrSize - 1]) {
                nextCurr[nextCurrSize++] = orVal;
            }
        }
        for (int j = 0; j < nextCurrSize; j++) {
            curr[j] = nextCurr[j];
            res[resSize++] = nextCurr[j];
        }
        currSize = nextCurrSize;
    }
    qsort(res, resSize, sizeof(int), compare);
    int uniqueCount = (resSize > 0) ? 1 : 0;
    for (int i = 1; i < resSize; i++) {
        if (res[i] != res[i - 1]) {
            uniqueCount++;
        }
    }
    free(res);
    return uniqueCount;
}
