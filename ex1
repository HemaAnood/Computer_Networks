#include <stdio.h>
#include <stdlib.h>
int* countBits(int n, int* returnSize) {
    *returnSize = n + 1;
    int* result = (int*)malloc((*returnSize) * sizeof(int));
    if (result == NULL) {
        return NULL;
    }
    result[0] = 0;
    for (int i = 1; i <= n; i++) {
        // i >> 1 divides by 2, i & 1 checks if the number is odd
        result[i] = result[i >> 1] + (i & 1);
    }
    
    return result;
}
