#include <stdlib.h>
#include <stdbool.h>

typedef struct AdjNode {
    int to;
    int dir; 
    struct AdjNode* next;
} AdjNode;

void dfs(int node, AdjNode** graph, bool* visited, int* count) {
    visited[node] = true;
    AdjNode* curr = graph[node];
    while (curr != NULL) {
        if (!visited[curr->to]) {
            if (curr->dir == 1) {
                (*count)++;
            }
            dfs(curr->to, graph, visited, count);
        }
        curr = curr->next;
    }
}

int minReorder(int n, int** connections, int connectionsSize, int* connectionsColSize) {
    AdjNode** graph = (AdjNode**)calloc(n, sizeof(AdjNode*));
    
    for (int i = 0; i < connectionsSize; i++) {
        int u = connections[i][0];
        int v = connections[i][1];
        
        AdjNode* node1 = (AdjNode*)malloc(sizeof(AdjNode));
        node1->to = v;
        node1->dir = 1; 
        node1->next = graph[u];
        graph[u] = node1;
        
        AdjNode* node2 = (AdjNode*)malloc(sizeof(AdjNode));
        node2->to = u;
        node2->dir = 0; 
        node2->next = graph[v];
        graph[v] = node2;
    }
    
    bool* visited = (bool*)calloc(n, sizeof(bool));
    int count = 0;
    
    dfs(0, graph, visited, &count);
    
    for (int i = 0; i < n; i++) {
        AdjNode* curr = graph[i];
        while (curr != NULL) {
            AdjNode* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(graph);
    free(visited);
    
    return count;
}

