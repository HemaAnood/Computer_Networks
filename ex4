#define INF INT_MAX

// Structure to represent an edge in the adjacency list
typedef struct Node {
    int target;
    int weight;
    struct Node* next;
} Node;

int networkDelayTime(int** times, int timesSize, int* timesColSize, int n, int k) {
    // 1. Initialize the adjacency list for nodes 1 to n
    Node** graph = (Node**)calloc((n + 1), sizeof(Node*));
    for (int i = 0; i < timesSize; i++) {
        int u = times[i][0];
        int v = times[i][1];
        int w = times[i][2];
        
        Node* newNode = (Node*)malloc(sizeof(Node));
        newNode->target = v;
        newNode->weight = w;
        newNode->next = graph[u];
        graph[u] = newNode;
    }

    // 2. Initialize distance array and visited array
    int* dist = (int*)malloc((n + 1) * sizeof(int));
    int* visited = (int*)calloc((n + 1), sizeof(int));
    for (int i = 1; i <= n; i++) {
        dist[i] = INF;
    }
    dist[k] = 0;

    // 3. Dijkstra's Algorithm using a basic min-scan (suitable for N up to 100)
    for (int count = 1; count <= n; count++) {
        // Find the unvisited node with the minimum distance
        int u = -1;
        int minDist = INF;
        for (int i = 1; i <= n; i++) {
            if (!visited[i] && dist[i] < minDist) {
                minDist = dist[i];
                u = i;
            }
        }

        // If we can't find a reachable node, break early
        if (u == -1) break;

        visited[u] = 1;

        // Update distances of neighboring nodes
        Node* curr = graph[u];
        while (curr != NULL) {
            int v = curr->target;
            int w = curr->weight;
            if (!visited[v] && dist[u] != INF && dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
            }
            curr = curr->next;
        }
    }

    // 4. Find the maximum time taken to reach any node
    int maxDelay = 0;
    for (int i = 1; i <= n; i++) {
        if (dist[i] == INF) {
            // Memory cleanup before returning
            for (int j = 1; j <= n; j++) {
                Node* curr = graph[j];
                while (curr) {
                    Node* temp = curr;
                    curr = curr->next;
                    free(temp);
                }
            }
            free(graph);
            free(dist);
            free(visited);
            return -1; // Node i is unreachable
        }
        if (dist[i] > maxDelay) {
            maxDelay = dist[i];
        }
    }

    // Free allocated memory
    for (int i = 1; i <= n; i++) {
        Node* curr = graph[i];
        while (curr) {
            Node* temp = curr;
            curr = curr->next;
            free(temp);
        }
    }
    free(graph);
    free(dist);
    free(visited);

    return maxDelay;
}
