#include <stdio.h>
#include <stdlib.h>
#include <stdbool.h>

typedef struct {
    int stop;
    int busCount;
} QueueNode;

int numBusesToDestination(int** routes, int routesSize, int* routesColSize, int source, int target) {
    if (source == target) return 0;
    int maxStop = 0;
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            if (routes[i][j] > maxStop) {
                maxStop = routes[i][j];
            }
        }
    }
    if (source > maxStop) maxStop = source;
    if (target > maxStop) maxStop = target;
    int* stopToBusesSizes = (int*)calloc(maxStop + 1, sizeof(int));
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            stopToBusesSizes[routes[i][j]]++;
        }
    }
    int** stopToBuses = (int**)malloc((maxStop + 1) * sizeof(int*));
    for (int i = 0; i <= maxStop; i++) {
        if (stopToBusesSizes[i] > 0) {
            stopToBuses[i] = (int*)malloc(stopToBusesSizes[i] * sizeof(int));
        } else {
            stopToBuses[i] = NULL;
        }
    }
    int* currentIndices = (int*)calloc(maxStop + 1, sizeof(int));
    for (int i = 0; i < routesSize; i++) {
        for (int j = 0; j < routesColSize[i]; j++) {
            int stop = routes[i][j];
            stopToBuses[stop][currentIndices[stop]++] = i;
        }
    }
    free(currentIndices);

    bool* visitedBuses = (bool*)calloc(routesSize, sizeof(bool));
    bool* visitedStops = (bool*)calloc(maxStop + 1, sizeof(bool));
    int maxQueueSize = maxStop + routesSize + 2; 
    QueueNode* queue = (QueueNode*)malloc(maxQueueSize * sizeof(QueueNode));
    int head = 0, tail = 0;
    queue[tail++] = (QueueNode){source, 0};
    visitedStops[source] = true;

    int minBuses = -1;
    while (head < tail) {
        QueueNode curr = queue[head++];
        int currStop = curr.stop;
        int currCount = curr.busCount;

        if (currStop == target) {
            minBuses = currCount;
            break;
        }

        for (int i = 0; i < stopToBusesSizes[currStop]; i++) {
            int busId = stopToBuses[currStop][i];

            if (!visitedBuses[busId]) {
                visitedBuses[busId] = true;
                for (int j = 0; j < routesColSize[busId]; j++) {
                    int nextStop = routes[busId][j];

                    if (!visitedStops[nextStop]) {
                        visitedStops[nextStop] = true;
                        queue[tail++] = (QueueNode){nextStop, currCount + 1};
                    }
                }
            }
        }
    }

    for (int i = 0; i <= maxStop; i++) {
        if (stopToBuses[i] != NULL) free(stopToBuses[i]);
    }
    free(stopToBuses);
    free(stopToBusesSizes);
    free(visitedBuses);
    free(visitedStops);
    free(queue);

    return minBuses;
}

